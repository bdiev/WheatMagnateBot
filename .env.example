DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_DM_CATEGORY_ID=
DISCORD_OWNER_ID=
# Recheck whitelist player skins and refresh Discord head emojis (default: 30 minutes).
PLAYER_HEAD_SKIN_SYNC_INTERVAL_MS=1800000
# Game chat -> Discord flood protection. Defaults shown below.
DISCORD_CHAT_QUEUE_MAX_SIZE=20
DISCORD_CHAT_MESSAGE_MAX_AGE_MS=15000
DISCORD_CHAT_USER_BURST=8
DISCORD_CHAT_USER_WINDOW_MS=10000
DISCORD_CHAT_DUPLICATE_WINDOW_MS=5000
DISCORD_CHAT_FLOOD_SUMMARY_DELAY_MS=5000
DISCORD_CHAT_MIN_SEND_INTERVAL_MS=250
# Discord OAuth for https://your-domain/request (the redirect URI must exactly
# match the URI registered in Discord Developer Portal).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://bdiev.org/api/request/auth/callback
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

DATABASE_URL=postgresql://user:password@localhost:5432/wheatmagnate
MINECRAFT_USERNAME=
MINECRAFT_AUTH=microsoft
MINECRAFT_PROFILES_FOLDER=data/auth-cache
MAX_BOT_ACCOUNTS=8
MAX_CONCURRENT_BOTS=3
# Minimum interval between Minecraft login handshakes. Increase to 15000-30000
# if the server/proxy rate-limits several accounts coming from one IP.
BOT_START_DELAY_MS=10000
# Random extra delay prevents all reconnect timers from forming a new wave.
BOT_START_JITTER_MS=3000
# Request only missing player PT/JD/Seen values. The default interval is 8 hours (3 checks/day).
PLAYER_INFO_CHECK_INTERVAL_MS=28800000
# Wait after connecting before the first check, then pause between chat commands to avoid flooding.
PLAYER_INFO_CHECK_INITIAL_DELAY_MS=30000
PLAYER_INFO_CHECK_COMMAND_DELAY_MS=3000

SITE_PORT=3080
SITE_ADMIN_USERNAME=
SITE_ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=
SITE_TRUST_PROXY=false
SITE_ALLOWED_ORIGINS=http://localhost:3080
# On Coolify, set SITE_TRUST_PROXY=true. COOLIFY_URL is also accepted as an exact allowed origin.
SSE_MAX_CONNECTIONS_PER_USER=3
SSE_HEARTBEAT_MS=25000
SSE_DATABASE_POLL_MS=250
LIVE_DASHBOARD_CACHE_MS=1000
OPERATIONAL_EVENT_RETENTION_DAYS=90
OBSIDIAN_ANALYTICS_TIMEZONE=Europe/Vilnius
OBSIDIAN_DAILY_REPORT_ENABLED=true
OBSIDIAN_DAILY_REPORT_HOUR=9
# Daily Obsidian reports are sent once per local day as a DM to DISCORD_OWNER_ID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DISABLE_BOT=false
WHITELIST_MODE=true
DANGER_RADIUS_BLOCKS=300
AUTO_EAT=true
